CRASHLYTICS_PROJECT=example-prod
CRASHLYTICS_APP_ID=1:111111111111:android:0000000000000000
CRASHLYTICS_APP_NAME=Example
# Путь к JSON-ключу сервисного аккаунта внутри контейнера; compose
# монтирует сюда каталог ./secrets.
GOOGLE_APPLICATION_CREDENTIALS=/secrets/google-service-account.json
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1000000000000
# Только там, где Telegram заблокирован. Пусто — ходим напрямую.
TELEGRAM_PROXY=
ERROR_TYPES=FATAL
SCHEDULE=0 10 * * *
STATE_PATH=/data/state.db
VERSION_WINDOW=3
WEEKLY_TOP=5
WEEKLY_WEEKDAY=0
TZ=Europe/Moscow

# --- Разбор крашей по стектрейсу (необязательно) ---------------------------
# Корень OpenAI-совместимого шлюза моделей и ключ к нему. Пусто в любом из
# двух — разбора нет, бот работает ровно как без этой возможности.
# Остальные настройки разбора (модель, таймаут, лимит, состав контекста)
# заданы параметрами в docker-compose.yml.
LLM_BASE_URL=
LLM_API_KEY=
